{
  "name": "allratestoday-widget",
  "version": "1.0.2",
  "description": "Free embeddable currency converter and official central-bank rate widgets for React, Vue, Astro and plain HTML. No API key needed.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./astro/CurrencyConverter.astro": "./astro/CurrencyConverter.astro",
    "./astro/OfficialRate.astro": "./astro/OfficialRate.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "vue.js",
    "vue.d.ts",
    "astro/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "currency-converter",
    "currency-widget",
    "exchange-rate-widget",
    "exchange-rates",
    "currency",
    "widget",
    "react",
    "vue",
    "astro",
    "central-bank",
    "ecb",
    "official-rates",
    "forex",
    "embed",
    "allratestoday"
  ],
  "homepage": "https://allratestoday.com/widget/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllRates-Today/allratestoday-widget.git"
  },
  "bugs": {
    "url": "https://github.com/AllRates-Today/allratestoday-widget/issues"
  },
  "author": "AllRatesToday (https://allratestoday.com)",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.44"
  }
}
